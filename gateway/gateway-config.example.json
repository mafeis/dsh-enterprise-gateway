{
  "policy": {
    "version": "1.0.0",
    "lockModelConfig": true,
    "watermark": true
  },
  "audit": {
    "level": "full",
    "retentionDays": 90
  },
  "dlp": {
    "enabled": true,
    "rules": [
      { "id": "apikey", "pattern": "sk-[A-Za-z0-9_-]{20,}", "action": "block", "label": "API密钥" },
      { "id": "bankcard", "pattern": "\\b\\d{16,19}\\b", "action": "mask", "label": "银行卡号" },
      { "id": "phone", "pattern": "\\b1[3-9]\\d{9}\\b", "action": "mask", "label": "手机号" }
    ]
  },
  "auth": {
    "deviceTokens": [],
    "loginProtection": { "enabled": true, "maxFails": 10, "windowMin": 15, "lockMin": 15 }
  },
  "providers": [
    {
      "id": "upstream-1",
      "name": "upstream-1",
      "baseUrl": "https://your-upstream.example.com/v1",
      "apiKeyEnv": "UPSTREAM_API_KEY",
      "timeoutMs": 120000,
      "weight": 10,
      "enabled": true
    }
  ],
  "models": [
    {
      "id": "deepseek-v4-flash",
      "displayName": "deepseek-v4-flash",
      "providerId": "upstream-1",
      "upstreamModel": "deepseek-v4-flash",
      "contextWindow": 128000,
      "maxTokens": 32768,
      "inputModes": ["text", "image"],
      "thinking": "optional",
      "thinkingLevels": ["off", "low", "medium", "high"],
      "defaultThinking": "low",
      "fallbackProviders": [],
      "enabled": true
    }
  ]
}
