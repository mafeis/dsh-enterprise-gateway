  "audit": {
    "level": "full",
    "retentionDays": 90,
    "maxContentChars": 1280000,
    "activityDays": 14,
    "activityLogins": 5,
    "activityDevices": 5,
    "activityUsage": 20
  },
  "probe": {
    "thinkingLevels": ["off", "low", "medium", "high"]
  },
  "dlp": {
    "enabled": true,
    "rules": [
      {
        "id": "apikey",
        "pattern": "sk-[A-Za-z0-9_-]{20,}",
        "action": "block",
        "label": "API密钥"
      },
      {
        "id": "aws-key",
        "pattern": "AKIA[0-9A-Z]{16}",
        "action": "block",
        "label": "AWS凭证"
      },
      {
        "id": "private-key",
        "pattern": "-----BEGIN[A-Z ]*PRIVATE KEY-----",
        "action": "block",
        "label": "私钥文件"
      },
      {
        "id": "jwt-token",
        "pattern": "eyJ[A-Za-z0-9_-]{8,}\\.[A-Za-z0-9_-]{8,}\\.[A-Za-z0-9_-]{4,}",
        "action": "block",
        "label": "JWT令牌"
      },
      {
        "id": "db-conn",
        "pattern": "(mongodb(\\+srv)?|mysql|postgres(ql)?|redis|amqps?)://[^\\s\"]{8,}",
        "action": "block",
        "label": "数据库连接串"
      },
      {
        "id": "bankcard",
        "pattern": "\\b\\d{16,19}\\b",
        "action": "mask",
        "label": "银行卡号"
      },
      {
        "id": "phone",
        "pattern": "\\b1[3-9]\\d{9}\\b",
        "action": "mask",
        "label": "手机号"
      },
      {
        "id": "idcard",
        "pattern": "\\b\\d{17}[\\dXx]\\b",
        "action": "mask",
        "label": "身份证号"
      },
      {
        "id": "email",
        "pattern": "[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\\.[A-Za-z]{2,}",
        "action": "mask",
        "label": "邮箱地址"
      },
      {
        "id": "internal-ip",
        "pattern": "\\b(10\\.\\d{1,3}\\.\\d{1,3}\\.\\d{1,3}|192\\.168\\.\\d{1,3}\\.\\d{1,3}|172\\.(1[6-9]|2\\d|3[01])\\.\\d{1,3}\\.\\d{1,3})\\b",
        "action": "log",
        "label": "内网IP"
      }
    ]
  },
  "auth": {
    "deviceTokens": [
      "<管理台签发的设备令牌，如 ent-dev-xxxx>"
    ],
    "deviceUser": "ent-device-<员工名>",
    "loginProtection": {
      "enabled": true,
      "maxFails": 10,
      "windowMin": 15,
      "lockMin": 15
    }
  },
  "providers": [
    {
      "id": "upstream-1",
      "name": "upstream-1",
      "baseUrl": "https://your-upstream.example.com/v1",
      "apiKeyEnv": "UPSTREAM_API_KEY",
      "apiKey": "<上游渠道密钥；留空则走 apiKeyEnv 环境变量>",
      "timeoutMs": 120000,
      "weight": 10,
      "enabled": true
    }
  ],
  "models": [
    {
      "id": "deepseek-v4-flash",
      "displayName": "deepseek-v4-flash",
      "providerId": "upstream-1",
      "upstreamModel": "deepseek-v4-flash",
      "contextWindow": 128000,
      "maxTokens": 32768,
      "inputModes": [
        "text",
        "image"
      ],
      "mode": "chat",
      "thinking": "optional",
      "thinkingLevels": [
        "off",
        "low",
        "medium",
        "high"
      ],
      "defaultThinking": "low",
      "fallbackProviders": [],
      "pricePer1kIn": 0,
      "pricePer1kOut": 0,
